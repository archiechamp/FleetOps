digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=1.0];
node [shape=plain fontname="DejaVu Sans"];
edge [color="#75869a" fontsize=9 fontname="DejaVu Sans" arrowsize=0.6];
"fuel.fuel_transactions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>fuel.fuel_transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">driver_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">fuel_type_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">transaction_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity_gallons</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(14,3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">price_per_gallon</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(19,4) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(19,4) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">currency_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CHAR(3) FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">odometer_miles</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(14,3) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">jurisdiction_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">merchant_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(200) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">connection_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">external_transaction_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(150) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">source_system</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD