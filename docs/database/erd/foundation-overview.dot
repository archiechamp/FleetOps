digraph foundation {
graph [rankdir=LR, bgcolor="white", pad=0.3]; node [shape=box, style="rounded,filled", fillcolor="#e9eff6", color="#7d8fa4", fontname="DejaVu Sans"]; edge [fontsize=9, color="#8193a8", arrowsize=0.6];
"core.tenants" [label="core.tenants\nid: UNIQUEIDENTIFIER"];
"core.tenants" -> "ref.currencies" [label="currency_code" ];
"core.tenant_settings" [label="core.tenant_settings\nid: UNIQUEIDENTIFIER"];
"core.tenant_settings" -> "core.tenants" [label="tenant_id" ];
"core.terminals" [label="core.terminals\nid: UNIQUEIDENTIFIER"];
"core.terminals" -> "core.tenants" [label="tenant_id" ];
"ref.countries" [label="ref.countries\nid: SMALLINT"];
"ref.jurisdictions" [label="ref.jurisdictions\nid: SMALLINT"];
"ref.jurisdictions" -> "ref.countries" [label="country_id" ];
"ref.currencies" [label="ref.currencies\ncode: CHAR(3)"];
"ref.asset_types" [label="ref.asset_types\nid: SMALLINT"];
"ref.fuel_types" [label="ref.fuel_types\nid: SMALLINT"];
"iam.users" [label="iam.users\nid: UNIQUEIDENTIFIER"];
"iam.memberships" [label="iam.memberships\nid: UNIQUEIDENTIFIER"];
"iam.memberships" -> "core.tenants" [label="tenant_id" ];
"iam.memberships" -> "iam.users" [label="user_id" ];
"iam.roles" [label="iam.roles\nid: UNIQUEIDENTIFIER"];
"iam.roles" -> "core.tenants" [label="tenant_id" ];
"iam.permissions" [label="iam.permissions\nid: UNIQUEIDENTIFIER"];
"iam.membership_roles" [label="iam.membership_roles\nid: UNIQUEIDENTIFIER"];
"iam.membership_roles" -> "core.tenants" [label="tenant_id" ];
"iam.membership_roles" -> "iam.memberships" [label="membership_id" ];
"iam.membership_roles" -> "iam.roles" [label="role_id" ];
"iam.role_permissions" [label="iam.role_permissions\nid: UNIQUEIDENTIFIER"];
"iam.role_permissions" -> "core.tenants" [label="tenant_id" ];
"iam.role_permissions" -> "iam.roles" [label="role_id" ];
"iam.role_permissions" -> "iam.permissions" [label="permission_id" ];
"fleet.assets" [label="fleet.assets\nid: UNIQUEIDENTIFIER"];
"fleet.assets" -> "core.tenants" [label="tenant_id" ];
"fleet.assets" -> "ref.asset_types" [label="asset_type_id" ];
"fleet.assets" -> "core.terminals" [label="terminal_id" ];
"fleet.assets" -> "ref.currencies" [label="currency_code" ];
"fleet.vehicles" [label="fleet.vehicles\nid: UNIQUEIDENTIFIER"];
"fleet.vehicles" -> "core.tenants" [label="tenant_id" ];
"fleet.vehicles" -> "fleet.assets" [label="asset_id" ];
"fleet.vehicles" -> "ref.jurisdictions" [label="plate_jurisdiction_id" ];
"fleet.vehicles" -> "ref.fuel_types" [label="fuel_type_id" ];
"audit.audit_events" [label="audit.audit_events\nid: BIGINT"];
"audit.audit_events" -> "core.tenants" [label="tenant_id" ];
"audit.audit_events" -> "iam.users" [label="actor_id" ];
}