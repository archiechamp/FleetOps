digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=1.0];
node [shape=plain fontname="DejaVu Sans"];
edge [color="#75869a" fontsize=9 fontname="DejaVu Sans" arrowsize=0.6];
"hr.drivers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>hr.drivers</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">membership_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">driver_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(30) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(254) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">employment_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(25) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">terminal_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">hire_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATE NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">timezone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(64) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
