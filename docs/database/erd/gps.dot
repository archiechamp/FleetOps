"gps.latest_vehicle_positions" -> "iam.memberships" [label="created_by" taillabel="0..*" headlabel="0..1"];
"gps.latest_vehicle_positions" -> "iam.memberships" [label="updated_by" taillabel="0..*" headlabel="0..1"];
"gps.latest_vehicle_positions" -> "gps.vehicle_positions" [label="position_id" taillabel="0..1" headlabel="1"];
"gps.telemetry_events" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"gps.telemetry_events" -> "fleet.assets" [label="asset_id" taillabel="0..*" headlabel="1"];
"gps.geofences" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"gps.geofences" -> "iam.memberships" [label="created_by" taillabel="0..*" headlabel="0..1"];
