digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=1.0];
node [shape=plain fontname="DejaVu Sans"];
edge [color="#75869a" fontsize=9 fontname="DejaVu Sans" arrowsize=0.6];
"gps.devices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.devices</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">connection_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">external_device_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(150) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">serial_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"gps.device_assignments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.device_assignments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">effective_from</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">effective_to</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"gps.vehicle_positions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.vehicle_positions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">device_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(9,6) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(9,6) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">speed_mph</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(14,3) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">heading_degrees</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(5,2) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">ignition_on</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">odometer_miles</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(14,3) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">recorded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">received_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">provider_event_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(150) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"gps.latest_vehicle_positions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.latest_vehicle_positions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">position_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">recorded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"gps.telemetry_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.telemetry_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">event_value</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(MAX) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">recorded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"gps.geofences" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.geofences</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(150) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">boundary</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">GEOGRAPHY NN</FONT></TD></TR><TR><TD ALIGN="LEFT">geofence_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"gps.geofence_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.geofence_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">geofence_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"gps.vehicle_fault_codes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.vehicle_fault_codes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">fault_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">severity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">detected_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">resolved_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"gps.idle_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>gps.idle_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">duration_seconds</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"core.tenants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>core.tenants</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR></TABLE>>];
"fleet.assets" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>fleet.assets</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR></TABLE>>];
"iam.memberships" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>iam.memberships</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR></TABLE>>];
"integration.connections" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>integration.connections</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR></TABLE>>];
"gps.devices" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"gps.devices" -> "integration.connections" [label="connection_id" taillabel="0..*" headlabel="1"];
"gps.devices" -> "iam.memberships" [label="created_by" taillabel="0..*" headlabel="0..1"];
"gps.devices" -> "iam.memberships" [label="updated_by" taillabel="0..*" headlabel="0..1"];
