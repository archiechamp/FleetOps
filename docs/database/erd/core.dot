digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=1.0];
node [shape=plain fontname="DejaVu Sans"];
edge [color="#75869a" fontsize=9 fontname="DejaVu Sans" arrowsize=0.6];
"core.tenants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>core.tenants</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(200) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">legal_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(200) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">dot_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">mc_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">timezone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(64) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">currency_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CHAR(3) FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR></TABLE>>];
"core.tenant_settings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>core.tenant_settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">setting_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">setting_value</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(MAX) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"core.terminals" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>core.terminals</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(150) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(500) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">timezone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(64) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"core.departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>core.departments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">terminal_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(150) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"core.business_entities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>core.business_entities</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">legal_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(200) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">registration_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">tax_reference</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"core.number_sequences" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>core.number_sequences</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">prefix</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">next_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"iam.memberships" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>iam.memberships</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR></TABLE>>];
"ref.currencies" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>ref.currencies</B></FONT></TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CHAR(3) PK NN</FONT></TD></TR></TABLE>>];
"core.tenants" -> "ref.currencies" [label="currency_code" taillabel="0..*" headlabel="1"];
"core.tenant_settings" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"core.tenant_settings" -> "iam.memberships" [label="created_by" taillabel="0..*" headlabel="0..1"];
"core.tenant_settings" -> "iam.memberships" [label="updated_by" taillabel="0..*" headlabel="0..1"];
"core.terminals" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"core.terminals" -> "iam.memberships" [label="created_by" taillabel="0..*" headlabel="0..1"];
"core.terminals" -> "iam.memberships" [label="updated_by" taillabel="0..*" headlabel="0..1"];
"core.departments" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"core.departments" -> "core.terminals" [label="terminal_id" taillabel="0..*" headlabel="0..1"];
"core.departments" -> "iam.memberships" [label="created_by" taillabel="0..*" headlabel="0..1"];
"core.departments" -> "iam.memberships" [label="updated_by" taillabel="0..*" headlabel="0..1"];
"core.business_entities" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"core.business_entities" -> "iam.memberships" [label="created_by" taillabel="0..*" headlabel="0..1"];
"core.business_entities" -> "iam.memberships" [label="updated_by" taillabel="0..*" headlabel="0..1"];
"core.number_sequences" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"core.number_sequences" -> "iam.memberships" [label="created_by" taillabel="0..*" headlabel="0..1"];
"core.number_sequences" -> "iam.memberships" [label="updated_by" taillabel="0..*" headlabel="0..1"];
}