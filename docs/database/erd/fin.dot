digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=1.0];
node [shape=plain fontname="DejaVu Sans"];
edge [color="#75869a" fontsize=9 fontname="DejaVu Sans" arrowsize=0.6];
"fin.revenue_items" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>fin.revenue_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">load_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">revenue_category_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(19,4) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">currency_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CHAR(3) FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">recognition_status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">recognized_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
"fin.expenses" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>fin.expenses</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">expense_category_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">vendor_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(500) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">expense_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATE NN</FONT></TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(19,4) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">currency_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CHAR(3) FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">source_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">source_reference</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(150) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">reconciliation_status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">approval_status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">approved_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">approved_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
