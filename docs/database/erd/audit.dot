digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=1.0];
node [shape=plain fontname="DejaVu Sans"];
edge [color="#75869a" fontsize=9 fontname="DejaVu Sans" arrowsize=0.6];
"audit.audit_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>audit.audit_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">old_values</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(MAX) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">new_values</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(MAX) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">correlation_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER NN</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"audit.security_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>audit.security_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">correlation_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER NN</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"audit.data_access_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>audit.data_access_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">resource_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">resource_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">access_reason</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(200) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"audit.export_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>audit.export_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">report_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">filter_metadata</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(MAX) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">exported_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"audit.approval_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>audit.approval_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">decision</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">approved_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR></TABLE>>];
"core.tenants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>core.tenants</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR></TABLE>>];
"iam.memberships" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>iam.memberships</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR></TABLE>>];
"iam.users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#e5e7eb" COLSPAN="2"><FONT COLOR="#25354a"><B>iam.users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR></TABLE>>];
"audit.audit_events" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"audit.audit_events" -> "iam.users" [label="actor_id" taillabel="0..*" headlabel="0..1"];
"audit.security_events" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"audit.security_events" -> "iam.users" [label="user_id" taillabel="0..*" headlabel="0..1"];
"audit.data_access_events" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"audit.data_access_events" -> "iam.users" [label="actor_id" taillabel="0..*" headlabel="0..1"];
"audit.export_events" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"audit.export_events" -> "iam.users" [label="user_id" taillabel="0..*" headlabel="1"];
"audit.approval_events" -> "core.tenants" [label="tenant_id" taillabel="0..*" headlabel="1"];
"audit.approval_events" -> "iam.memberships" [label="approved_by" taillabel="0..*" headlabel="1"];
}