digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=1.0];
node [shape=plain fontname="DejaVu Sans"];
edge [color="#75869a" fontsize=9 fontname="DejaVu Sans" arrowsize=0.6];
"ops.loads" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8093a5"><TR><TD BGCOLOR="#17344d" COLSPAN="2"><FONT COLOR="white"><B>ops.loads</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER PK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">load_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(40) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_reference</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(100) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">commodity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(255) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">weight_lbs</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DECIMAL(14,3) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">equipment_type_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">commercial_status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(25) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">special_instructions</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NVARCHAR(MAX) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">currency_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CHAR(3) FK NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATETIME2(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ROWVERSION NN</FONT></TD></TR><TR><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUEIDENTIFIER FK NULL</FONT></TD></TR></TABLE>>];
