# Local-only development values. Keep .env ignored and use distinct test credentials.
FLEETOPS_ENV=development
FLEETOPS_DATABASE_NAME=fleetops_dev
FLEETOPS_SQL_SERVER=sqlserver
FLEETOPS_SQL_ENCRYPT=yes
FLEETOPS_SQL_TRUST_SERVER_CERTIFICATE=no
FLEETOPS_SQL_BOOTSTRAP_USER=
FLEETOPS_SQL_BOOTSTRAP_PASSWORD=
FLEETOPS_SQL_MIGRATION_USER=
FLEETOPS_SQL_MIGRATION_PASSWORD=
FLEETOPS_MIGRATION_APPROVED_TARGET=
FLEETOPS_SQL_RUNTIME_USER=
FLEETOPS_SQL_RUNTIME_PASSWORD=
FLEETOPS_CLERK_ISSUER=
FLEETOPS_CLERK_AUTHORIZED_PARTY=
# Backend secret is required to check current session state and deny revocation.
# The optional public key verifies signatures locally before that status check.
FLEETOPS_CLERK_SECRET_KEY=
FLEETOPS_CLERK_JWT_KEY=
FLEETOPS_AI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
# One-shot pilot onboarding inputs (review against Clerk and the intended SQL database).
FLEETOPS_PILOT_CLERK_USER_ID=
FLEETOPS_PILOT_TENANT_NAME=
FLEETOPS_PILOT_TENANT_SLUG=
FLEETOPS_PILOT_TIMEZONE=
