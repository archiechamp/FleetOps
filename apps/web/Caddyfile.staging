:{$PORT:8080} {
    root * /srv
    encode gzip

    @api path /api/* /health/*
    handle @api {
        reverse_proxy {$FLEETOPS_API_UPSTREAM:api:8000}
    }

    @config path /config.js
    handle @config {
        header Content-Type application/javascript
        header Cache-Control "no-store"
        templates {
            mime application/javascript
        }
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
